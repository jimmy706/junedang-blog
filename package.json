{
	"name": "junedang-blog",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"cf:dev": "wrangler pages dev .svelte-kit/cloudflare",
		"cf:deploy": "wrangler pages deploy .svelte-kit/cloudflare --project-name ${CF_PAGES_PROJECT_NAME:-junedang-blog}",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-cloudflare": "^7.2.7",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.51.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/jsdom": "^27.0.0",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.24",
		"jsdom": "^27.4.0",
		"svelte": "^5.51.1",
		"svelte-check": "^4.4.0",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^3.2.4",
		"wrangler": "^4.50.0"
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.13.5",
		"dotenv": "^17.3.1",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^2.36.0",
		"mermaid": "^11.12.2",
		"node-cache": "^5.1.2",
		"npm-check-updates": "^18.3.1"
	}
}
